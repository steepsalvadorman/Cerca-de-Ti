DATABASE_URL=postgres://cerca:cerca@localhost:5433/cerca
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080
RUST_LOG=backend=debug,tower_http=debug
# Comma-separated browser origins allowed to call the API (e.g.
# https://admin.cercadeti.pe). Leave empty for the mobile-only app:
# native clients are not subject to CORS, so an empty list simply means
# no browser can call this API cross-origin.
CORS_ALLOWED_ORIGINS=
# S3-compatible bucket holding technician verification documents. Any
# provider works — only these values change:
#   Cloudflare R2  S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com  S3_REGION=auto
#   Backblaze B2   S3_ENDPOINT=https://s3.<region>.backblazeb2.com         S3_REGION=<region>
#   Supabase       S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3 S3_REGION=<region>
#
# Leave empty until the bucket exists: everything else keeps working and
# only document uploads answer 503. The bucket must be PRIVATE — these
# are identity papers, and both uploads and reads go through short-lived
# signed URLs.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
