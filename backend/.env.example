DATABASE_URL=postgres://cerca:cerca@localhost:5433/cerca
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080
RUST_LOG=backend=debug,tower_http=debug
# Comma-separated browser origins allowed to call the API (e.g.
# https://admin.cercadeti.pe). Leave empty for the mobile-only app:
# native clients are not subject to CORS, so an empty list simply means
# no browser can call this API cross-origin.
CORS_ALLOWED_ORIGINS=
